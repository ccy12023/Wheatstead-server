# Wheatstead 多人控制服配置。复制成 .env，按需修改，不要提交。

# ── 必填 ──────────────────────────────────────────────
# 接受的发行 AppID，逗号分隔。Demo 和正式版可以一起写；Playtest 也支持。
# 例如：正式版 5485050，Demo 5489270
WHEATSTEAD_STEAM_APP_IDS=5485050,5489270

# Steamworks 发行商 Web API Key（partner.steam-api.com），只放环境变量。
WHEATSTEAD_STEAM_WEB_API_KEY=

# 入场令牌 HMAC 密钥，至少 32 字节；世界进程必须用同一个值。
WHEATSTEAD_MULTIPLAYER_TOKEN_SECRET=

# SQLite 数据库路径（目录必须可写）。
WHEATSTEAD_MULTIPLAYER_DB=/var/lib/wheatstead/server/multiplayer.db
WHEATSTEAD_LEADERBOARD_DB=/var/lib/wheatstead/server/leaderboard.db

# ── 世界 ──────────────────────────────────────────────
# 首次建库时写入的世界名；之后的改名走管理后台或数据库。
WHEATSTEAD_WORLD_NAME=My Wheatstead World
# 世界进程注册用的世界 ID，默认 official-1。
# WHEATSTEAD_WORLD_ID=official-1

# ── 代验证（可选，二选一）────────────────────────────
# 不配置 Web API Key，把票据转发给中心服务验证；Key 只留在中心服务上。
# WHEATSTEAD_LICENSE_RELAY_URL=https://relay.example.com
# WHEATSTEAD_LICENSE_RELAY_TOKEN=中心服务发给你的令牌，至少 32 字节

# ── 可选 ──────────────────────────────────────────────
# 监听地址，默认 http://127.0.0.1:8081
# WHEATSTEAD_LEADERBOARD_URLS=http://127.0.0.1:8081
# Steam Web API 地址，默认 https://partner.steam-api.com
# WHEATSTEAD_STEAM_API_URL=https://partner.steam-api.com
# 是否允许家庭共享账号进服，默认 0
# WHEATSTEAD_STEAM_ALLOW_FAMILY_SHARING=0
# 入场令牌有效期（秒），30-600，默认 120
# WHEATSTEAD_MULTIPLAYER_TOKEN_TTL_SECONDS=120
# 管理后台密码
# WHEATSTEAD_LEADERBOARD_ADMIN_PASSWORD=
# 世界重置任务（需要 reset worker）
# WHEATSTEAD_RESET_WORKER_ENABLED=0
# 问题反馈邮件（可选，不配就不发）
# WHEATSTEAD_FEEDBACK_SMTP_HOST=
# WHEATSTEAD_FEEDBACK_SMTP_PORT=587
# WHEATSTEAD_FEEDBACK_SMTP_USER=
# WHEATSTEAD_FEEDBACK_SMTP_PASSWORD=
# WHEATSTEAD_FEEDBACK_SMTP_FROM=
# WHEATSTEAD_FEEDBACK_RECIPIENT=
