<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Wheatstead.PlaytestServer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <None Update="reset/worker.py" CopyToPublishDirectory="PreserveNewest" />
    <None Update="reset/restore_stage.py" CopyToPublishDirectory="PreserveNewest" />
    <None Update="reset/recovery_preflight.py" CopyToPublishDirectory="PreserveNewest" />
    <None Update="reset/migrate.py" CopyToPublishDirectory="PreserveNewest" />
    <None Update="reset/bootstrap_empty.py" CopyToPublishDirectory="PreserveNewest" />
    <None Update="reset/wheatstead-reset-worker.service" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="web/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.32" />
    <PackageReference Include="MailKit" Version="4.18.1" />
  </ItemGroup>
</Project>
